{$CASEBOOK_API_DOMAIN} {
	encode gzip
	# 확장 120호 — 접속 기록. 종전에는 log 지시자가 없어 Caddy 가 에러만 남겼다: 데모를 누가
	# 열었는지 알 길이 없었고, 그래서 "아무도 안 봤다" 와 "보고 관심 없었다" 를 구분할 수 없었다.
	# 그 둘은 다음에 무엇을 고칠지가 정반대다.
	# stderr 로 내면 docker compose logs 로 보고 도커가 알아서 굴린다 — 볼륨도 로테이션도 없다.
	log {
		output stderr
		format json
	}
	# /mcp 는 빼야 한다. 경로에 토큰이 실려 있어 통째로 켜면 그것이 로그에 그대로 박힌다 —
	# MCP 문이 uvicorn access_log 를 끈 이유가 바로 그것이다(mcp_server.py: "토큰이 경로에 있다").
	log_skip /mcp*
	# 원격 MCP 문 (확장 27호): https://<domain>/mcp/<token> — 커넥터(Claude.ai·ChatGPT)가 붙는 자리
	handle /mcp* {
		reverse_proxy mcp:8790
	}
	# 자원 서버 메타데이터 (RFC 9728, 확장 93호) — 401 의 WWW-Authenticate 가 이 주소를 가리킨다.
	# /mcp 로 시작하지 않아 그냥 두면 아래 handle 이 api 로 보내고 404 가 난다(2026-09-14 실측).
	# 인증 없이 읽히는 공개 문서라 문 앞에 두는 것이 맞다.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy mcp:8790
	}
	# 신청 페이지와 그 길 둘 (확장 101호) — 문이 HTML 까지 직접 낸다. 정적 폴더를 따로 두지 않는
	# 이유는 신원 확인이 전부 문에 있기 때문이다: 페이지와 그것이 부르는 길이 갈리면 어긋난다.
	handle /join* {
		reverse_proxy mcp:8790
	}
	# 읽기 전용 데모 (확장 63호): demo 컨테이너가 만든 정적 폴더. index.html 은 data/… 를 상대 경로로 읽는다.
	redir /demo /demo/
	handle_path /demo/* {
		root * /srv/demo/site
		# 캐시 머리가 없으면 브라우저가 제 어림짐작으로 오래 쥔다 — 데모를 고쳐 올려도 돌아온
		# 사람은 옛 화면을 본다(실측 2026-09-14: 첫 화면을 현황으로 바꿨는데 회고가 그대로 보였다).
		# no-cache 는 "쓰지 말라"가 아니라 "쓰기 전에 물어보라"다. ETag 가 있어 대개 304 로 끝난다.
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy api:8787
	}
}
