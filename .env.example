# API 컨테이너 환경 — compose 가 읽는다. 실제 값은 .env(gitignored)에.
OPENAI_API_KEY=
CASEBOOK_EFFORT=none
CASEBOOK_WORKERS=4
# 가입 초대 코드 — 콤마 구분. 비우면 누구나 가입(로컬 전용)
CASEBOOK_INVITE_CODES=
# 프론트 origin — 콤마 구분. 비우면 * (로컬 개발 전용)
CASEBOOK_CORS_ORIGINS=https://casebook.syncflo.cloud
# Caddy 가 TLS 를 받을 API 호스트명 (Route53 A 레코드가 이 서버를 가리켜야 한다). MCP 문도 같은 호스트의 /mcp/<token>.
CASEBOOK_API_DOMAIN=casebook-api.syncflo.cloud
# 읽기 전용 데모(확장 63호)가 보여줄 기록의 주인 — 비우면 demo 컨테이너가 시작하자마자 멈춘다
CASEBOOK_DEMO_EMAIL=
# 데모에 낼 주제 이름 둘 — 그 주제의 스레드만 나간다(확장 63호). 둘 다 비우면 demo 컨테이너가 멈춘다
CASEBOOK_DEMO_TOPIC=
CASEBOOK_DEMO_TOPIC2=
# 그 안에서 더 뺄 스레드 번호, 콤마 구분 (예: 자동 조사가 원본만 쌓고 결론이 없는 것)
CASEBOOK_DEMO_SKIP=
